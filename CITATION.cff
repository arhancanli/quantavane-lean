    given-names: Arhan
    affiliation: Quantavane
    email: arhan@quantavane.com
license: Apache-2.0
url: "https://quantavane.com"
repository-code: "https://github.com/arhancanli/quantavane-lean"
keywords:
  - Lean 4
  - Erdős problems
  - distinct distances
  - convex polygons
  - SAT
  - LRAT
